{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Hub",
  "mainBinaryName": "LanHub",
  "version": "0.2.0",
  "identifier": "dev.lancollab.lanhub",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LAN Hub",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LAN Collab",
    "shortDescription": "LAN Hub",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
