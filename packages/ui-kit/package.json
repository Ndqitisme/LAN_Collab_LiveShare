{
  "name": "@lan-collab/ui-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Shared tokens, themes and Svelte 5 components for the LAN Collab extension webviews and the LAN Hub app.",
  "license": "MIT",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vscode.css": "./src/vscode.css",
    "./app.css": "./src/app.css",
    "./tokens.css": "./src/tokens.css",
    "./theme-vscode.css": "./src/theme-vscode.css",
    "./theme-app.css": "./src/theme-app.css",
    "./base.css": "./src/base.css"
  },
  "scripts": {
    "gallery": "vite",
    "build": "vite build",
    "check": "svelte-check --workspace . --fail-on-warnings",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  }
}
