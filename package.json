{
  "name": "lan-collab",
  "displayName": "LAN Collab",
  "description": "Chỉnh sửa cộng tác thời gian thực qua LAN Hub trong mạng nội bộ, không phụ thuộc dịch vụ đám mây. Mỗi máy làm việc trên bản sao file của dự án.",
  "version": "0.1.1",
  "publisher": "ndqitisme",
  "author": {
    "name": "Ndqitisme"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ndqitisme/LAN_Collab_LiveShare.git"
  },
  "homepage": "https://github.com/Ndqitisme/LAN_Collab_LiveShare#readme",
  "bugs": {
    "url": "https://github.com/Ndqitisme/LAN_Collab_LiveShare/issues"
  },
  "keywords": [
    "collaboration",
    "live share",
    "pair programming",
    "lan",
    "self-hosted",
    "real-time",
    "operational transformation"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b2a6f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension/src/activate.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node tools/check-strings.mjs && node test/i18n.test.js && node test/connection-machine.test.js && node test/diagnostics.test.js && node test/secrets.test.js && node test/report.test.js && node test/ot.test.js && node --test \"test/conformance/*.test.js\"",
    "test:conformance": "node --test \"test/conformance/*.test.js\"",
    "pretest:vscode": "npm run build:webviews",
    "test:vscode": "node test/vscode/run.js",
    "build:webviews": "node extension/webview-src/build.mjs",
    "test:webviews": "vitest run extension/webview-src",
    "check:webviews": "svelte-check --workspace extension/webview-src --fail-on-warnings",
    "vscode:prepublish": "npm run build:webviews",
    "hub": "node hub/hub.js",
    "loadgen": "node tools/loadgen.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx --yes @vscode/vsce@3 package --no-dependencies -o dist/",
    "package:hub": "node tools/package-hub.js",
    "package:all": "npm run package && npm run package:hub"
  },
  "contributes": {
    "commands": [
      {
        "command": "lanCollab.connect",
        "title": "Kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.disconnect",
        "title": "Ngắt kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.follow",
        "title": "Đi theo thành viên",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.unfollow",
        "title": "Thôi đi theo",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.setStatus",
        "title": "Đặt trạng thái",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.showLog",
        "title": "Xem nhật ký",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.menu",
        "title": "Mở menu",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.openChat",
        "title": "Mở chat",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.signIn",
        "title": "Chọn tài khoản VS Code",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.join",
        "title": "Tham gia bằng mã mời",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.copyInvite",
        "title": "Sao chép mã mời",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.diagnose",
        "title": "Chẩn đoán kết nối",
        "category": "LAN Collab"
      }
    ],
    "views": {
      "lanCollab": [
        {
          "type": "webview",
          "id": "lanCollab.session",
          "name": "Thành viên"
        },
        {
          "type": "webview",
          "id": "lanCollab.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "LAN Collab",
      "properties": {
        "lanCollab.server": {
          "type": "string",
          "default": "",
          "markdownDescription": "Địa chỉ LAN Hub dạng `IP:cổng`, ví dụ `192.168.1.10:8200`. Không cần đặt khi thư mục đã tham gia bằng mã mời."
        },
        "lanCollab.project": {
          "type": "string",
          "default": "",
          "markdownDescription": "Tên dự án trên LAN Hub. Nên đặt trong `.vscode/settings.json` của dự án."
        },
        "lanCollab.token": {
          "type": "string",
          "default": "",
          "description": "Token của LAN Hub. Khi LAN Collab khởi động, token đặt ở đây được chuyển vào kho bí mật của hệ điều hành và bị xoá khỏi cài đặt."
        },
        "lanCollab.name": {
          "type": "string",
          "default": "",
          "description": "Tên hiển thị với thành viên khác. Để trống thì dùng tên tài khoản VS Code, hoặc tài-khoản-Windows@tên-máy khi chưa đăng nhập.",
          "scope": "application"
        },
        "lanCollab.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Tự động kết nối khi mở thư mục đã gắn với LAN Hub qua mã mời, hoặc qua lanCollab.server và lanCollab.project."
        },
        "lanCollab.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Tự động lưu file đang mở khoảng 0,4 giây sau mỗi thay đổi, để bản trên ổ đĩa của mọi máy luôn cập nhật. Trình chạy, debugger và công cụ AI đều đọc từ ổ đĩa."
        },
        "lanCollab.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Mẫu glob không đồng bộ, bổ sung vào danh sách mặc định gồm `.git`, `.venv`, `venv`, `node_modules`, `__pycache__`, `*.pyc`, `.lan-collab`, `~$*`, `.DS_Store`, `Thumbs.db`. Ví dụ: `[\"output.csv\", \"build/**\"]`."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lanCollab",
          "title": "LAN Collab",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "ffmpeg-static": "^5.3.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
