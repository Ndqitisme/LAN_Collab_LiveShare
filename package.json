{
  "name": "lan-collab",
  "displayName": "LAN Collab",
  "description": "Chỉnh sửa cộng tác thời gian thực qua LAN Hub trong mạng nội bộ, không phụ thuộc dịch vụ đám mây. Mỗi máy làm việc trên bản sao file của dự án.",
  "version": "0.1.1",
  "publisher": "ndqitisme",
  "author": {
    "name": "Ndqitisme"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ndqitisme/LAN_Collab_LiveShare.git"
  },
  "homepage": "https://github.com/Ndqitisme/LAN_Collab_LiveShare#readme",
  "bugs": {
    "url": "https://github.com/Ndqitisme/LAN_Collab_LiveShare/issues"
  },
  "keywords": [
    "collaboration",
    "live share",
    "pair programming",
    "lan",
    "self-hosted",
    "real-time",
    "operational transformation"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b2a6f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension/src/activate.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node tools/check-strings.mjs && node test/i18n.test.js && node test/connection-machine.test.js && node test/diagnostics.test.js && node test/secrets.test.js && node test/report.test.js && node test/ot.test.js && node test/sync-plan.test.js && node test/revert.test.js && node test/history-client.test.js && node test/status-bar.test.js && node test/when-clauses.test.js && node --test \"test/conformance/*.test.js\"",
    "test:conformance": "node --test \"test/conformance/*.test.js\"",
    "pretest:vscode": "npm run build:webviews",
    "test:vscode": "node test/vscode/run.js",
    "build:webviews": "node extension/webview-src/build.mjs",
    "test:webviews": "vitest run extension/webview-src",
    "check:webviews": "svelte-check --workspace extension/webview-src --fail-on-warnings",
    "vscode:prepublish": "npm run build:webviews",
    "hub": "node hub/hub.js",
    "loadgen": "node tools/loadgen.mjs",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx --yes @vscode/vsce@3 package --no-dependencies -o dist/",
    "package:hub": "node tools/package-hub.js",
    "package:all": "npm run package && npm run package:hub",
    "package:lanhub": "node tools/package-lanhub.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "lanCollab.connect",
        "title": "Kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.disconnect",
        "title": "Ngắt kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.follow",
        "title": "Đi theo thành viên",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.unfollow",
        "title": "Thôi đi theo",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.setStatus",
        "title": "Đặt trạng thái",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.showLog",
        "title": "Xem nhật ký",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.menu",
        "title": "Mở menu",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.openChat",
        "title": "Mở chat",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.signIn",
        "title": "Chọn tài khoản VS Code",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.join",
        "title": "Tham gia bằng mã mời",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.copyInvite",
        "title": "Sao chép mã mời",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.diagnose",
        "title": "Chẩn đoán kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.openConnection",
        "title": "Thiết lập kết nối",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.restoreBackup",
        "title": "Khôi phục từ bản sao lưu",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.showHistory",
        "title": "Xem lịch sử chỉnh sửa",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.openAfter",
        "title": "Mở bản sau lượt chỉnh sửa",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.diffCurrent",
        "title": "So sánh với bản hiện tại",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.diffBefore",
        "title": "So sánh với bản trước đó",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.copy",
        "title": "Sao chép nội dung",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.revert",
        "title": "Hoàn tác lượt chỉnh sửa này",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.restoreFile",
        "title": "Khôi phục file",
        "category": "LAN Collab"
      },
      {
        "command": "lanCollab.history.restoreVersion",
        "title": "Khôi phục phiên bản này",
        "category": "LAN Collab"
      }
    ],
    "views": {
      "lanCollab": [
        {
          "id": "lanCollab.start",
          "name": "Bắt đầu",
          "when": "!lanCollab.connected"
        },
        {
          "type": "webview",
          "id": "lanCollab.session",
          "name": "Thành viên"
        },
        {
          "type": "webview",
          "id": "lanCollab.chat",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "lanCollab.history",
          "name": "Lịch sử chỉnh sửa"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "lanCollab.connect",
          "when": "lanCollab.state =~ /^(idle|stopped|needs_action)$/"
        },
        {
          "command": "lanCollab.join",
          "when": "lanCollab.state =~ /^(idle|stopped|needs_action)$/"
        },
        {
          "command": "lanCollab.disconnect",
          "when": "lanCollab.state =~ /^(resolving|connecting|handshaking|syncing|live|reconnecting|needs_action)$/"
        },
        {
          "command": "lanCollab.follow",
          "when": "lanCollab.state == live"
        },
        {
          "command": "lanCollab.unfollow",
          "when": "lanCollab.state == live && lanCollab.following"
        },
        {
          "command": "lanCollab.setStatus",
          "when": "lanCollab.state == live"
        },
        {
          "command": "lanCollab.copyInvite",
          "when": "lanCollab.state == live"
        },
        {
          "command": "lanCollab.history.openAfter",
          "when": "false"
        },
        {
          "command": "lanCollab.history.diffCurrent",
          "when": "false"
        },
        {
          "command": "lanCollab.history.diffBefore",
          "when": "false"
        },
        {
          "command": "lanCollab.history.copy",
          "when": "false"
        },
        {
          "command": "lanCollab.history.revert",
          "when": "false"
        },
        {
          "command": "lanCollab.history.restoreFile",
          "when": "false"
        },
        {
          "command": "lanCollab.history.restoreVersion",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lanCollab.openChat",
        "key": "ctrl+alt+l c",
        "mac": "cmd+alt+l c"
      },
      {
        "command": "lanCollab.follow",
        "key": "ctrl+alt+l f",
        "mac": "cmd+alt+l f"
      },
      {
        "command": "lanCollab.showHistory",
        "key": "ctrl+alt+l h",
        "mac": "cmd+alt+l h"
      }
    ],
    "viewsWelcome": [
      {
        "view": "lanCollab.start",
        "contents": "Chưa kết nối LAN Hub.\n[Thiết lập kết nối](command:lanCollab.openConnection)\n[Tham gia bằng mã mời](command:lanCollab.join)"
      }
    ],
    "walkthroughs": [
      {
        "id": "lanCollab.start",
        "title": "Bắt đầu với LAN Collab",
        "description": "Tham gia dự án trên LAN Hub, kiểm tra kết nối, nhắn cho các thành viên và xem lịch sử chỉnh sửa.",
        "steps": [
          {
            "id": "invite",
            "title": "Lấy mã mời",
            "description": "Mã mời có trong ứng dụng LAN Hub, hoặc lấy từ một thành viên của dự án qua \"Sao chép mã mời\". Màn hình \"Kết nối LAN Hub\" còn liệt kê LAN Hub tìm thấy trong mạng LAN.\n[Thiết lập kết nối](command:lanCollab.openConnection)",
            "media": {
              "svg": "extension/media/walkthrough/invite.svg",
              "altText": "Mã mời của dự án và chìa khoá"
            },
            "completionEvents": [
              "onCommand:lanCollab.openConnection"
            ]
          },
          {
            "id": "join",
            "title": "Tham gia dự án",
            "description": "Dán mã mời để đồng bộ dự án vào thư mục đang mở hoặc một thư mục trống.\n[Tham gia bằng mã mời](command:lanCollab.join)",
            "media": {
              "svg": "extension/media/walkthrough/join.svg",
              "altText": "Hai thư mục đồng bộ với LAN Hub"
            },
            "completionEvents": [
              "onCommand:lanCollab.join",
              "onContext:lanCollab.connected"
            ]
          },
          {
            "id": "diagnose",
            "title": "Kiểm tra kết nối",
            "description": "Chẩn đoán kết nối chạy theo thứ tự các bước kiểm tra tới LAN Hub. Bước không đạt có hướng dẫn cách xử lý.\n[Chẩn đoán kết nối](command:lanCollab.diagnose)",
            "media": {
              "svg": "extension/media/walkthrough/diagnose.svg",
              "altText": "Danh sách các bước chẩn đoán kết nối"
            },
            "completionEvents": [
              "onCommand:lanCollab.diagnose"
            ]
          },
          {
            "id": "chat",
            "title": "Nhắn cho dự án",
            "description": "Chat gửi tin nhắn, ảnh và vị trí trong file tới các thành viên đang trực tuyến. Phím tắt Ctrl+Alt+L rồi C mở chat, Ctrl+Alt+L rồi F đi theo một thành viên.\n[Mở chat](command:lanCollab.openChat)",
            "media": {
              "svg": "extension/media/walkthrough/chat.svg",
              "altText": "Hai tin nhắn chat giữa các thành viên"
            },
            "completionEvents": [
              "onCommand:lanCollab.openChat"
            ]
          },
          {
            "id": "history",
            "title": "Xem lịch sử chỉnh sửa",
            "description": "Lịch sử chỉnh sửa liệt kê từng lượt chỉnh sửa của các thành viên trên file đang mở. Mỗi lượt chỉnh sửa mở, so sánh, sao chép hoặc hoàn tác được. Phím tắt Ctrl+Alt+L rồi H.\n[Xem lịch sử chỉnh sửa](command:lanCollab.showHistory)",
            "media": {
              "svg": "extension/media/walkthrough/history.svg",
              "altText": "Danh sách lượt chỉnh sửa của hai thành viên trên một file"
            },
            "completionEvents": [
              "onCommand:lanCollab.showHistory"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "LAN Collab",
      "properties": {
        "lanCollab.server": {
          "type": "string",
          "default": "",
          "markdownDescription": "Địa chỉ LAN Hub dạng `IP:cổng`, ví dụ `192.168.1.10:8200`. Không cần đặt khi thư mục đã tham gia bằng mã mời.",
          "order": 1
        },
        "lanCollab.project": {
          "type": "string",
          "default": "",
          "markdownDescription": "Tên dự án trên LAN Hub. Nên đặt trong `.vscode/settings.json` của dự án.",
          "order": 2
        },
        "lanCollab.token": {
          "type": "string",
          "default": "",
          "description": "Token của LAN Hub. Khi LAN Collab khởi động, token đặt ở đây được chuyển vào kho bí mật của hệ điều hành và bị xoá khỏi cài đặt.",
          "order": 3
        },
        "lanCollab.autoConnect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tự động kết nối khi mở thư mục đã gắn với LAN Hub qua mã mời, hoặc qua `#lanCollab.server#` và `#lanCollab.project#`.",
          "order": 4
        },
        "lanCollab.name": {
          "type": "string",
          "default": "",
          "description": "Tên hiển thị với thành viên khác. Để trống thì dùng tên tài khoản VS Code, hoặc tài-khoản-Windows@tên-máy khi chưa đăng nhập.",
          "scope": "application",
          "order": 5
        },
        "lanCollab.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Tự động lưu file đang mở khoảng 0,4 giây sau mỗi thay đổi, để bản trên ổ đĩa của mọi máy luôn cập nhật. Trình chạy, debugger và công cụ AI đều đọc từ ổ đĩa.",
          "order": 6
        },
        "lanCollab.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Mẫu glob không đồng bộ, bổ sung vào danh sách mặc định gồm `.git`, `.venv`, `venv`, `node_modules`, `__pycache__`, `*.pyc`, `.lan-collab`, `~$*`, `.DS_Store`, `Thumbs.db`. Ví dụ: `[\"output.csv\", \"build/**\"]`.",
          "order": 7
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lanCollab",
          "title": "LAN Collab",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "ffmpeg-static": "^5.3.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
